generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER MANAGEMENT
// ==========================================

model User {
  id              String    @id @default(uuid())
  name            String?
  email           String    @unique
  password        String?   // Nullable for OAuth users
  googleId        String?   @unique
  role            String    @default("user") // user | admin
  isPro           Boolean   @default(false)
  resumeUrl       String?
  resumeText      String?   @db.Text
  parsedSkills    String[]
  parsedIndustries String[]
  phone           String?
  prefersSMS      Boolean   @default(false)
  referralCode    String    @unique @default(uuid())
  emailVerified   Boolean   @default(false)
  onboardingComplete Boolean @default(false)
  preferences     Json?     // Store user preferences
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?
  
  // Relations
  alerts          Alert[]
  matches         Match[]
  payments        Payment[]
  applications    Application[]
  referralsGiven  Referral[]  @relation("Referrer")
  referralsReceived Referral[] @relation("Referred")
  interactions    Interaction[]
  apiKeys         ApiKey[]
  savedOpportunities SavedOpportunity[]
  
  @@index([email])
  @@index([referralCode])
  @@index([isPro])
}

// ==========================================
// OPPORTUNITIES
// ==========================================

model Opportunity {
  id              String    @id @default(uuid())
  title           String
  organization    String
  country         String
  region          String?
  type            String    // job | fellowship | consultancy | grant | tender
  remote          Boolean   @default(false)
  description     String    @db.Text
  requirements    String?   @db.Text
  salary          String?
  deadline        DateTime?
  source          String
  sourceUrl       String    @unique
  aiSummary       String?   @db.Text
  aiKeywords      String[]
  qualityScore    Float     @default(0)
  viewCount       Int       @default(0)
  applyCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  matches         Match[]
  applications    Application[]
  interactions    Interaction[]
  savedBy         SavedOpportunity[]
  
  @@index([country])
  @@index([type])
  @@index([remote])
  @@index([createdAt])
  @@index([deadline])
  @@index([qualityScore])
}

// ==========================================
// AI MATCHING & RANKING
// ==========================================

model Match {
  id              String    @id @default(uuid())
  userId          String
  opportunityId   String
  
  // AI Matching Scores
  gptMatchScore   Float     // 0-100 from GPT-4
  explanation     String    @db.Text
  
  // Location Matching
  locationScore   Float     @default(0)
  
  // Behavioral Learning
  behaviorScore   Float     @default(0)
  userTypePreference Float  @default(0)
  
  // Freshness
  freshnessScore  Float     @default(0)
  
  // Final Ranking
  finalRank       Float     // Weighted combination
  
  // Metadata
  notified        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity     Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  @@unique([userId, opportunityId])
  @@index([userId, finalRank])
  @@index([notified])
}

model Interaction {
  id              String    @id @default(uuid())
  userId          String
  opportunityId   String
  type            String    // viewed | applied | saved | unsaved | dismissed
  metadata        Json?     // Additional context
  createdAt       DateTime  @default(now())
  
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity     Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  @@index([userId, type])
  @@index([opportunityId, type])
  @@index([createdAt])
}

// ==========================================
// ALERTS & NOTIFICATIONS
// ==========================================

model Alert {
  id                  String    @id @default(uuid())
  userId              String
  keywords            String
  locationPreference  String?
  typePreference      String?   // job | fellowship | etc
  frequency           String    // daily | weekly | instant
  active              Boolean   @default(true)
  lastSent            DateTime?
  sendCount           Int       @default(0)
  createdAt           DateTime  @default(now())
  
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([active, frequency])
  @@index([userId])
}

// ==========================================
// APPLICATIONS & TRACKING
// ==========================================

model Application {
  id              String    @id @default(uuid())
  userId          String
  opportunityId   String
  status          String    @default("applied") // applied | interview | offer | rejected | withdrawn
  notes           String?   @db.Text
  coverLetter     String?   @db.Text
  aiGenerated     Boolean   @default(false)
  appliedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity     Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  @@unique([userId, opportunityId])
  @@index([userId, status])
}

model SavedOpportunity {
  id              String    @id @default(uuid())
  userId          String
  opportunityId   String
  savedAt         DateTime  @default(now())
  
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity     Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  @@unique([userId, opportunityId])
  @@index([userId])
}

// ==========================================
// REFERRAL SYSTEM
// ==========================================

model Referral {
  id              String    @id @default(uuid())
  referrerId      String
  referredEmail   String
  referredId      String?
  status          String    @default("pending") // pending | converted | expired
  rewardGranted   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  convertedAt     DateTime?
  
  referrer        User      @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred        User?     @relation("Referred", fields: [referredId], references: [id], onDelete: SetNull)
  
  @@index([referrerId, status])
  @@index([referredEmail])
}

// ==========================================
// PAYMENTS & MONETIZATION
// ==========================================

model Payment {
  id              String    @id @default(uuid())
  userId          String
  amount          Float
  currency        String    @default("USD")
  status          String    // pending | completed | failed | refunded
  stripeSessionId String?   @unique
  stripePaymentIntent String? @unique
  paymentDate     DateTime?
  type            String    // pro | api_access | enterprise
  metadata        Json?
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
}

// ==========================================
// SCRAPER MANAGEMENT
// ==========================================

model ScraperSource {
  id              String    @id @default(uuid())
  name            String
  baseUrl         String
  active          Boolean   @default(true)
  type            String    // job | fellowship | grant | tender
  frequency       String    @default("hourly") // hourly | daily | weekly
  lastRun         DateTime?
  lastSuccess     DateTime?
  errorCount      Int       @default(0)
  successCount    Int       @default(0)
  totalScraped    Int       @default(0)
  config          Json?     // Scraper-specific config
  createdAt       DateTime  @default(now())
  
  @@index([active])
  @@index([type])
}

// ==========================================
// API ACCESS
// ==========================================

model ApiKey {
  id              String    @id @default(uuid())
  userId          String
  key             String    @unique
  name            String?
  active          Boolean   @default(true)
  rateLimit       Int       @default(1000) // Requests per hour
  createdAt       DateTime  @default(now())
  lastUsed        DateTime?
  usageCount      Int       @default(0)
  expiresAt       DateTime?
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([key])
  @@index([userId])
}

// ==========================================
// EXPERIMENTS & A/B TESTING
// ==========================================

model Experiment {
  id              String    @id @default(uuid())
  name            String
  description     String?
  variantA        Json      // Configuration for variant A
  variantB        Json      // Configuration for variant B
  active          Boolean   @default(true)
  startDate       DateTime  @default(now())
  endDate         DateTime?
  conversionEventA Int      @default(0)
  conversionEventB Int      @default(0)
  impressionA     Int       @default(0)
  impressionB     Int       @default(0)
  createdAt       DateTime  @default(now())
  
  @@index([active])
}

model ExperimentAssignment {
  id              String    @id @default(uuid())
  experimentId    String
  userId          String
  variant         String    // A | B
  converted       Boolean   @default(false)
  assignedAt      DateTime  @default(now())
  
  @@unique([experimentId, userId])
  @@index([experimentId, variant])
}

// ==========================================
// ANALYTICS & METRICS
// ==========================================

model DailyMetric {
  id              String    @id @default(uuid())
  date            DateTime  @db.Date
  metric          String
  value           Float
  metadata        Json?
  
  @@unique([date, metric])
  @@index([date])
  @@index([metric])
}

model SystemLog {
  id              String    @id @default(uuid())
  level           String    // info | warn | error | critical
  source          String    // scraper | api | cron | auth
  message         String    @db.Text
  metadata        Json?
  createdAt       DateTime  @default(now())
  
  @@index([level, createdAt])
  @@index([source])
}
