generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(uuid())
  coreUserId           String?   @unique
  name                 String?
  email                String    @unique
  password             String?
  googleId             String?   @unique
  role                 String    @default("user")
  isPro                Boolean   @default(false)
  resumeUrl            String?
  resumeText           String?   @db.Text
  parsedSkills         String[]  @default([])
  parsedIndustries     String[]  @default([])
  phone                String?
  prefersSMS           Boolean   @default(false)
  referralCode         String    @unique @default(uuid())
  emailVerified        Boolean   @default(false)
  onboardingComplete   Boolean   @default(false)
  preferences          Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  lastLoginAt          DateTime?

  alerts               Alert[]
  matches              Match[]
  payments             Payment[]
  applications         Application[]
  referralsGiven       Referral[]  @relation("Referrer")
  referralsReceived    Referral[]  @relation("Referred")
  interactions         Interaction[]
  apiKeys              ApiKey[]
  savedOpportunities   SavedOpportunity[]
  radarSessions        RadarSession[]
  workspaces           OpportunityWorkspace[]
  workspaceMemberships WorkspaceMember[]
  workspaceComments    WorkspaceComment[]
  userDocuments        UserDocument[]
  notifications        Notification[]
  subscriptionUsage    SubscriptionUsage[]
  deliveries           DeliveryEvent[]
  capabilityProfile    CapabilityProfile?

  @@index([email])
  @@index([referralCode])
  @@index([isPro])
}


model CapabilityProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  profileType           String   @default("individual")
  legalName             String?
  registrationNumber    String?
  registrationCountry   String?
  yearsOperating        Int?
  turnoverBand          String?
  sectors               String[] @default([])
  countries             String[] @default([])
  donorExperience       String[] @default([])
  licences              String[] @default([])
  referenceCount        Int      @default(0)
  canRecruitSpecialists Boolean  @default(false)
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([profileType])
  @@index([registrationCountry])
}

model RadarSession {
  id                 String   @id
  userId             String
  coreOrganizationId String?
  coreBusinessId     String?
  coreAccess         Json?
  corePermissionCodes String[] @default([])
  createdAt          DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  expiresAt          DateTime
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Opportunity {
  id              String    @id @default(uuid())
  title           String
  organization    String
  country         String
  region          String?
  type            String
  remote          Boolean   @default(false)
  description     String    @db.Text
  requirements    String?   @db.Text
  salary          String?
  deadline        DateTime?
  source          String
  sourceUrl       String    @unique
  applicationUrl  String?
  applicationEmail String?
  applicationInstructions String? @db.Text
  applicationVerifiedAt DateTime?
  canonicalKey    String?
  referenceNumber String?
  sector          String?
  currency        String?
  valueMin        Float?
  valueMax        Float?
  contractDuration String?
  submissionMethod String?
  languages       String[]  @default([])
  eligibilityCountries String[] @default([])
  publishedAt     DateTime?
  discoveredAt    DateTime  @default(now())
  lastVerifiedAt  DateTime  @default(now())
  closedAt        DateTime?
  sourceStatus    String    @default("live")
  verificationStatus String @default("verified")
  aiSummary       String?   @db.Text
  aiKeywords      String[]  @default([])
  qualityScore    Float     @default(0)
  viewCount       Int       @default(0)
  applyCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  matches         Match[]
  applications    Application[]
  interactions    Interaction[]
  savedBy         SavedOpportunity[]
  workspaces      OpportunityWorkspace[]
  sources         OpportunitySource[]

  @@index([country])
  @@index([type])
  @@index([remote])
  @@index([createdAt])
  @@index([deadline])
  @@index([qualityScore])
  @@index([canonicalKey])
  @@index([sourceStatus, lastVerifiedAt])
  @@index([verificationStatus])
  @@index([sector])
  @@index([publishedAt])
  @@index([applicationVerifiedAt])
}

model OpportunitySource {
  id              String    @id @default(uuid())
  opportunityId   String
  sourceName      String
  sourceUrl       String    @unique
  sourceType      String?
  discoveredAt    DateTime  @default(now())
  lastVerifiedAt  DateTime  @default(now())
  status          String    @default("live")
  rawMetadata     Json?
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
  @@index([sourceName, status])
  @@index([lastVerifiedAt])
}

model Match {
  id                 String    @id @default(uuid())
  userId             String
  opportunityId      String
  gptMatchScore      Float
  explanation        String    @db.Text
  keySkillMatches    String[]  @default([])
  missingRequirements String[] @default([])
  hardConstraints    String[]  @default([])
  specialistNeeds    String[]  @default([])
  confidence         Float     @default(0.5)
  locationScore      Float     @default(0)
  behaviorScore      Float     @default(0)
  userTypePreference Float     @default(0)
  freshnessScore     Float     @default(0)
  finalRank          Float
  notified           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity        Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@unique([userId, opportunityId])
  @@index([userId, finalRank])
  @@index([notified])
}

model Interaction {
  id              String    @id @default(uuid())
  userId          String
  opportunityId   String
  type            String
  metadata        Json?
  createdAt       DateTime  @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity     Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@index([userId, type])
  @@index([opportunityId, type])
  @@index([createdAt])
}

model Alert {
  id                  String    @id @default(uuid())
  userId              String
  keywords            String
  locationPreference  String?
  typePreference      String?
  frequency           String
  active              Boolean   @default(true)
  lastSent            DateTime?
  sendCount           Int       @default(0)
  createdAt           DateTime  @default(now())
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([active, frequency])
  @@index([userId])
}

model Application {
  id              String    @id @default(uuid())
  userId          String
  opportunityId   String
  status          String    @default("applied")
  notes           String?   @db.Text
  coverLetter     String?   @db.Text
  aiGenerated     Boolean   @default(false)
  appliedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity     Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@unique([userId, opportunityId])
  @@index([userId, status])
}

model SavedOpportunity {
  id              String    @id @default(uuid())
  userId          String
  opportunityId   String
  savedAt         DateTime  @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity     Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@unique([userId, opportunityId])
  @@index([userId])
}

model OpportunityWorkspace {
  id                   String    @id @default(uuid())
  userId               String
  opportunityId        String
  name                 String
  status               String    @default("drafting")
  progress             Int       @default(0)
  submissionDeadline   DateTime?
  aiPlan               String?   @db.Text
  aiPlanStructured     Json?
  lastAiInteractionId  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity          Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  documents            WorkspaceDocument[]
  members              WorkspaceMember[]
  comments             WorkspaceComment[]

  @@unique([userId, opportunityId])
  @@index([userId, status])
  @@index([submissionDeadline])
}

model WorkspaceDocument {
  id              String    @id @default(uuid())
  workspaceId     String
  title           String
  kind            String
  status          String    @default("pending")
  content         String?   @db.Text
  generatedByAi   Boolean   @default(false)
  version         Int       @default(1)
  checksum        String?
  evidenceRefs    Json?
  lastSavedByUserId String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       OpportunityWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  comments        WorkspaceComment[]

  @@unique([workspaceId, title])
  @@index([workspaceId, status])
}

model WorkspaceMember {
  id              String    @id @default(uuid())
  workspaceId     String
  userId          String?
  name            String?
  email           String
  role            String    @default("reviewer")
  status          String    @default("invited")
  createdAt       DateTime  @default(now())
  workspace       OpportunityWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([userId])
}

model WorkspaceComment {
  id              String    @id @default(uuid())
  workspaceId     String
  documentId      String?
  authorUserId    String?
  authorName      String?
  body            String    @db.Text
  status          String    @default("open")
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  workspace       OpportunityWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document        WorkspaceDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author          User?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([documentId])
}

model UserDocument {
  id              String    @id @default(uuid())
  userId          String
  title           String
  category        String
  fileName        String?
  mimeType        String?
  content         String?   @db.Text
  sourceType      String    @default("manual")
  checksum        String?
  verificationStatus String @default("unverified")
  extractedClaims Json?
  version         Int       @default(1)
  metadata        Json?
  expiresAt       DateTime?
  lastReviewedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([expiresAt])
}

model Notification {
  id              String    @id @default(uuid())
  userId          String
  type            String
  title           String
  body            String    @db.Text
  metadata        Json?
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

model SubscriptionUsage {
  id              String    @id @default(uuid())
  userId          String
  metric          String
  periodKey       String
  count           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metric, periodKey])
  @@index([userId, periodKey])
}

model Referral {
  id              String    @id @default(uuid())
  referrerId      String
  referredEmail   String
  referredId      String?
  status          String    @default("pending")
  rewardGranted   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  convertedAt     DateTime?
  referrer        User      @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred        User?     @relation("Referred", fields: [referredId], references: [id], onDelete: SetNull)
  @@index([referrerId, status])
  @@index([referredEmail])
}

model Payment {
  id                  String    @id @default(uuid())
  userId              String
  amount              Float
  currency            String    @default("USD")
  status              String
  stripeSessionId     String?   @unique
  stripePaymentIntent String?   @unique
  paymentDate         DateTime?
  type                String
  metadata            Json?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([status])
}

model ScraperSource {
  id              String    @id @default(uuid())
  name            String
  baseUrl         String
  active          Boolean   @default(true)
  type            String
  frequency       String    @default("hourly")
  lastRun         DateTime?
  lastSuccess     DateTime?
  errorCount      Int       @default(0)
  successCount    Int       @default(0)
  totalScraped    Int       @default(0)
  config          Json?
  createdAt       DateTime  @default(now())
  runs            ScrapeRun[]
  @@index([active])
  @@index([type])
}


model ScrapeRun {
  id              String    @id @default(uuid())
  sourceId        String
  status          String    @default("running")
  scraped         Int       @default(0)
  inserted        Int       @default(0)
  duplicates      Int       @default(0)
  errors          Int       @default(0)
  durationMs      Int?
  errorMessage    String?   @db.Text
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  source          ScraperSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
  @@index([status, startedAt])
}

model RadarJob {
  id              String    @id @default(uuid())
  type            String
  status          String    @default("queued")
  payload         Json
  dedupeKey       String?   @unique
  attempts        Int       @default(0)
  maxAttempts     Int       @default(5)
  runAt           DateTime  @default(now())
  lockedAt        DateTime?
  completedAt     DateTime?
  lastError       String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, runAt])
  @@index([type, status])
}

model DeliveryEvent {
  id                String    @id @default(uuid())
  userId            String
  kind              String
  channel           String
  status            String    @default("queued")
  recipientMasked   String?
  providerMessageId String?
  attemptCount      Int       @default(0)
  lastError         String?   @db.Text
  metadata          Json?
  scheduledFor      DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, channel])
}

model ApiKey {
  id              String    @id @default(uuid())
  userId          String
  key             String    @unique
  name            String?
  active          Boolean   @default(true)
  rateLimit       Int       @default(1000)
  createdAt       DateTime  @default(now())
  lastUsed        DateTime?
  usageCount      Int       @default(0)
  expiresAt       DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([key])
  @@index([userId])
}

model Experiment {
  id               String    @id @default(uuid())
  name             String
  description      String?
  variantA         Json
  variantB         Json
  active           Boolean   @default(true)
  startDate        DateTime  @default(now())
  endDate          DateTime?
  conversionEventA Int       @default(0)
  conversionEventB Int       @default(0)
  impressionA      Int       @default(0)
  impressionB      Int       @default(0)
  createdAt        DateTime  @default(now())
  @@index([active])
}

model ExperimentAssignment {
  id              String    @id @default(uuid())
  experimentId    String
  userId          String
  variant         String
  converted       Boolean   @default(false)
  assignedAt      DateTime  @default(now())
  @@unique([experimentId, userId])
  @@index([experimentId, variant])
}

model DailyMetric {
  id              String    @id @default(uuid())
  date            DateTime  @db.Date
  metric          String
  value           Float
  metadata        Json?
  @@unique([date, metric])
  @@index([date])
  @@index([metric])
}

model SystemLog {
  id              String    @id @default(uuid())
  level           String
  source          String
  message         String    @db.Text
  metadata        Json?
  createdAt       DateTime  @default(now())
  @@index([level, createdAt])
  @@index([source])
}
