{
  "name": "radar-platform",
  "version": "1.0.0",
  "description": "AI-powered opportunity aggregation platform for Africa",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch server/index.mjs",
    "build": "prisma generate && vite build --config frontend/vite.config.js",
    "start": "node server/index.mjs",
    "lint": "tsc --noEmit --pretty false",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "scraper:run": "tsx scripts/runScrapers.ts",
    "alerts:start": "tsx alerts/scheduler.ts",
    "worker": "tsx workers/worker.ts",
    "trust:backfill": "tsx scripts/backfillOpportunityTrust.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:homepage": "mkdir -p dist && cp public/index.html dist/index.html",
    "serve:homepage": "python3 -m http.server 4173 --directory public",
    "prisma:deploy": "prisma db push --skip-generate"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "framer-motion": "^11.15.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.0",
    "pdf-parse": "^1.1.1",
    "posthog-js": "^1.96.1",
    "posthog-node": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^4.6.12",
    "stripe": "^14.9.0",
    "tailwindcss": "^3.4.0",
    "twilio": "^4.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.32",
    "prisma": "^5.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tuku-tuku/radar.git"
  },
  "keywords": ["jobs","opportunities","africa","ai","matching","careers"],
  "author": "Tuku-Tuku Innovation Labs",
  "license": "PROPRIETARY"
}
